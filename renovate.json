{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rysk-tanaka/workflows#41caae6bf816cb53a25c1a03637b73992f6b38b1",
    "group:allNonMajor",
    ":enablePreCommit"
  ],
  "enabledManagers": ["npm", "cargo", "github-actions", "pre-commit", "custom.regex"],
  "lockFileMaintenance": { "enabled": true },
  "cargo": { "lockFileMaintenance": { "enabled": false } },
  "packageRules": [
    {
      "description": "The shared preset automerges every minor/patch update; GitHub Actions updates stay manual here",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    }
  ]
}
