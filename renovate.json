{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rysk-tanaka/workflows#02f082fbc0a61d0a121b3ce79ecfbcfd1bc579c7",
    "group:allNonMajor",
    ":enablePreCommit"
  ],
  "enabledManagers": ["npm", "cargo", "github-actions", "pre-commit", "custom.regex"],
  "lockFileMaintenance": { "enabled": true },
  "cargo": { "lockFileMaintenance": { "enabled": false } },
  "packageRules": [
    {
      "description": "The shared preset automerges every minor/patch update; GitHub Actions updates stay manual here",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    }
  ]
}
